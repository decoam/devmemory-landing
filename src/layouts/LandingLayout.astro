---
import '../styles/global.css';
import ThemeToggle from '../components/shared/ThemeToggle.svelte';

interface Props {
  title?: string;
}

const { title = 'Devmemory' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Devmemory - AI-powered error tracking and solution repository" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (function() {
        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', saved || (prefersDark ? 'neoDark' : 'neoLight'));
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background font-body text-content">
    <div class="absolute right-4 top-4 z-10">
      <ThemeToggle client:load />
    </div>
    <slot />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  body {
    transition: background-color 0.2s, color 0.2s;
  }
</style>